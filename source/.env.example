# Comma-separated ChatGPT account emails allowed to access /admin.
ADMIN_EMAILS=seller@example.com

# Trusted deployed origin used for absolute social links before launch.
SITE_ORIGIN=https://your-site.example

# Secret used to HMAC reviewer codes and session tokens. Generate at least 32 random bytes.
REVIEWER_AUTH_SECRET=replace-with-a-long-random-secret
